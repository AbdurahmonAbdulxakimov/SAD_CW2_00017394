<mxCell id="slaughter_67" value="&lt;b&gt;NFR-04&lt;/b&gt;&lt;br&gt;Crew pay = birds × pay per bird, shown while typing, so the crew is paid before they leave." style="shape=note;size=14;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#FFF9B1;strokeColor=#C9B800;fontFamily=Comic Sans MS;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="170" width="250" height="94" as="geometry"/></mxCell>
<mxCell id="slaughter_68" value='&lt;b&gt;History&lt;/b&gt;&lt;br&gt;Every session is one row, like Excel. Totals at the bottom. "Download for Excel" gives a CSV file.' style="shape=note;size=14;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#FFF9B1;strokeColor=#C9B800;fontFamily=Comic Sans MS;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="280" width="250" height="94" as="geometry"/></mxCell>
